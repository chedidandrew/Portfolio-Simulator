    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "10.18.0",
    "katex": "^0.16.27",
    "lucide-react": "0.556.0",
    "lz-string": "1.5.0",
