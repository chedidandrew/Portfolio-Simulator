    "jsdom": "^26.1.0",
    "playwright": "1.62.0",
    "postcss": "8.5.26",
    "tailwind-merge": "2.6.1",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.0",
