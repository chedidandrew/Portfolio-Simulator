    "test:browser:chromium": "node scripts/browser-smoke.mjs",
    "test:browser:loan": "node scripts/browser-loan-smoke.mjs",
    "test:browser:tools": "node scripts/browser-financial-tools-smoke.mjs",
    "test:browser:webkit": "node scripts/browser-webkit-smoke.mjs",
    "test:browser:a11y": "node scripts/browser-accessibility.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run test && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
