    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "currencies:update": "node scripts/update-currencies.mjs",
    "test": "tsx --tsconfig tsconfig.test.json --test lib/simulation/financial.test.ts lib/simulation/timeline-refinement.test.ts lib/simulation/planning-insights.test.ts lib/loan/loan-engine.test.ts lib/financial-tools/financial-tools.test.ts lib/regression.test.ts lib/hardening.test.ts && npm run test:components",
